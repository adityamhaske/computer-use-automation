# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# The ONLY thing that needs a key is the live discovery run (brief §4).
# Replay, escalation, the full test suite, and `make demo` all work without one;
# demo falls back to a recorded transcript and says so explicitly.

# --- LLM (OpenRouter / Omniroute — any OpenAI-compatible gateway) -------------
OPENROUTER_API_KEY=
CUA_LLM_BASE_URL=https://openrouter.ai/api/v1
CUA_LLM_MODEL=anthropic/claude-sonnet-4.5

# Hard budget caps for a discovery run. The loop stops when any is hit.
CUA_LLM_MAX_STEPS=40
CUA_LLM_MAX_TOKENS=200000
CUA_LLM_TIMEOUT_S=120

# --- Surfaces ----------------------------------------------------------------
CUA_MOCK_APP_PORT=8811
CUA_CONSOLE_PORT=8812
CUA_HEADLESS=true

# --- Safety ------------------------------------------------------------------
# Path to the allowlist / risk policy. Nothing acts outside it.
CUA_POLICY_FILE=config/policy.yaml

# Demo credentials for the MOCK app only. These are fake, and the system still
# treats them as secrets: they are referenced as {$secret: ...} from artifacts
# and are redacted from every log, artifact, screenshot and LLM prompt.
CUA_MOCK_USERNAME=teller01
CUA_MOCK_PASSWORD=not-a-real-password
